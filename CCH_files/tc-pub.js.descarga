document.querySelectorAll('.dfr').forEach(item=>{item.addEventListener('click',event=>{document.querySelectorAll('.dfr').forEach(items=>{items.classList.remove('cin3c_active-c67');});let numberseason=item.getAttribute('data-season');let serie=item.getAttribute('data-serie');var params=new URLSearchParams();params.append('action','action_change_episode');params.append('season',numberseason);params.append('serie',serie);axios.post(torocinema.url,params).then(function(res){if(res.status==200){document.querySelector('.cin3c_episodios-c67').innerHTML='';let html='';for(let i=0;i<res.data.d.length;i++){html+='<li class="mark-1">';html+='<div class="cin3c_imagen-c67">'+res.data.d[i]["image"]+'</div>';html+='<div class="cin3c_numerando-c67">EP | '+res.data.d[i]["episode"]+'</div>';html+='<div class="cin3c_episodiotitle-c67"><a href="'+res.data.d[i]["url"]+'">Episodio '+res.data.d[i]["episode"]+'</a></div>'
html+='</li>';}
document.querySelector('.cin3c_episodios-c67').innerHTML=html;}}).catch(function(err){console.error(err);}).then(function(){});item.classList.add('cin3c_active-c67');})});let openmdl=document.querySelector('#mdl-ads');if(openmdl){console.log('as11');if(getCookie('accept_mdl')!='on'){console.log('as12');setTimeout(()=>{document.querySelector('#mdl-ads').classList.add('on');},2000);}}
var closemdl=document.querySelector('#mdl-close-modal');if(closemdl){closemdl.addEventListener('click',function(e){e.preventDefault();document.querySelector('#mdl-ads').classList.remove('on');});}
var acmdl=document.querySelector('#modalAds_ok');if(acmdl){acmdl.addEventListener('click',function(e){e.preventDefault();createCookie('accept_mdl','on','2');document.querySelector('#mdl-ads').classList.remove('on');});}
