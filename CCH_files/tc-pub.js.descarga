var embed=plyr.querySelector('iframe')||plyr.firstChild;embed.src=mv.dataset.src;}
if(element.classList.contains('cin3c_hidden-c67')){element.classList.remove('cin3c_hidden-c67');}
mv.classList.add('cin3c_opsc-current-c67');}}});});};var _links=function(){var links=document.querySelectorAll('[data-link]');links.forEach((element)=>{element.addEventListener('click',function(event){var mv=event.currentTarget;if(mv!==null){window.open(window.atob(mv.dataset.url));console.log(window.atob(mv.dataset.url))}});});};var _close=function(){var close=document.querySelector('[data-close]');if(close!==null){close.addEventListener('click',function(event){var tpnv=document.querySelectorAll('ul.py-2.options > li > a');tpnv.forEach((element)=>{element.classList.remove('cin3c_opsc-current-c67');});var element=document.querySelector('[data-element]');var plyr=document.querySelector('[data-player]');if(plyr!==null){plyr.classList.add('cin3c_hidden-c67');var embed=plyr.querySelector('iframe')||plyr.firstChild;embed.src=embed.src;}
element.classList.add('cin3c_hidden-c67');});}};var _open=function(){var open=document.querySelector('[data-open]');if(open!==null){open.addEventListener('click',function(event){var tpnv=document.querySelectorAll('ul.py-2.options > li > a');tpnv.forEach((element)=>{if(element.classList.contains('cin3c_opsc-current-c67')){window.open(window.atob(element.dataset.src));}});});}};return{init:function(){_console();_options();_links();_close();_open();}};})();if(typeof module!=='undefined'){module.exports=TTTC;}
