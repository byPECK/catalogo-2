//Social
function resenas() {
			$('.realert').hide();
			$.ajax({
			    type:"POST",
			    url:authdomain+"/api/resenas",
			    data: {anime: $("#guardar-anime").attr('data-anime'), p: pagina, orden: $('.reviews-form').val()},
			    success:function(data){
				console.log(data);

			    $('.resenas #qloader').hide();

				$('.re-count').text(data.total).show();

				if(data.last_page > pagina) {
				$(".more_re").show();
				} else {
				$(".more_re").hide();
				}

				if(data.data.length > 0) {
			    $.each(data.data, function(i, item) {
						// Genera tantas estrellas como indique el número (ej: 4 -> 4 etiquetas <i>)
						var numEstrellas = item.estrellas || 0;
						var htmlEstrellas = '<i class="ti ti-star-filled"></i>'.repeat(numEstrellas);

						$('.resenas .relist').append(
							'<div class="review-item d-bg d-border">' +
								'<div class="review-avatar avatar-1">' +
									'<img src="' + item.user.avatar + '">' +
								'</div>' +
								'<div class="review-content">' +
									'<div class="review-header">' +
										'<p class="review-name">' + item.user.usuario + '</p>' +
										'<span class="review-date"><i class="far fa-clock mr-1"></i>' + item.fechahumana + '</span>' +
									'</div>' +
									'<div class="review-stars">' +
										htmlEstrellas +
									'</div>' +
									'<p class="review-text">' + item.body + '</p>' +
									'<div class="btn-group mt-2 d-border" data-review="'+item.id+'" role="group" aria-label="Votos"><button type="button" data-vote="like" class="btn btn-vote d-bg3 b-dark2 t-dark ' + (item.userlike ? 'active' : '') + '"><i class="ti ti-thumb-up"></i><span>' + (item.likes == null ? 0 : item.likes) + '</span></button><button type="button" data-vote="dislike" class="btn btn-vote d-bg3 b-dark2 t-dark ' + (item.userdislike ? 'active' : '') + '"><i class="ti ti-thumb-down"></i><span>' + (item.dislikes == null ? 0 : item.dislikes) + '</span></button></div>' +
								'</div>' +
							'</div>'
						);
					});
				} else {
					$('.realert').show();
				}
			     },
			     error: function(xhr, status, error) {
				if(onerror) {onerror();}console.log(xhr.responseText);if(xhr.responseText == "token") { sesion_invalida();}
				},
			     dataType: "json"
			});
}

//User info
let usr_info = false;
let api_usr_pending_promise = null;

//Login auth google/discord
const queryString = window.location.search;
if (queryString.includes('?autologin=true')) {
	crear_cookie('jkauth', true, 43800);
	location.href = $(".header__logo a").attr('href');
}

function api_usr() {
	if (api_usr_pending_promise) {
		return api_usr_pending_promise;
	}

	if (usr_info && typeof usr_info !== 'boolean' && usr_info.authenticated !== false) {
		return $.Deferred().resolve(usr_info).promise();
	}

	if (sessionLocal.getItem('api_usr_attempted_and_failed') && !leer_cookie('jkauth')) {
		usr_info = { authenticated: false };
		return $.Deferred().resolve(usr_info).promise();
	}

	api_usr_pending_promise = $.ajax({
		type: "POST",
		url: authdomain + "/api/usuario",
		dataType: "json"
	})
	.then(function(data) {
		api_usr_pending_promise = null;

		sessionLocal.removeItem('api_usr_attempted_and_failed');

		usr_info = data;
		$('.usr-menu').addClass('img');
		return data;
	})
	.fail(function(jqXHR, textStatus, errorThrown) {
		api_usr_pending_promise = null;

		try {
			// Intenta parsear la respuesta del error
			const errorData = jparse(jqXHR.responseText);
			// Comprueba si el mensaje es el específico que buscas
			if (jqXHR.status === 401 && errorData.message === 'Unauthenticated.') {

				sessionLocal.setItem('api_usr_attempted_and_failed', 'true');

				if(leer_cookie('jkauth')) {
					sesion_invalida();
				}


			}
		} catch (e) {
			// El error no es un JSON o no tiene el formato esperado,
			// así que no hacemos nada con el sessionLocal.
		}

		usr_info = { authenticated: false, message: 'API error', error: errorThrown };
		return $.Deferred().reject(errorThrown).promise();
	});

	return api_usr_pending_promise;
}


function es_guardado_directorio(){
	const items = [];

	$.ajax({
		type:"POST",
		url:authdomain+"/api/json_guardados",
		data: {api_token: api_token},
		success:function(data){
			if(data == "token") { sesion_invalida();}
			//console.log(data);
			testdata = data;
			if($('.page_g').length) {
				$( ".page_g .svea" ).each(function() {
					$(this).fadeIn();
					var g = $(this).attr('data-anime');

					//$(this).removeAttr("data-g");

					var faicon = "ti-shield-plus";
					var title = "guardar";
					if(data[g] !== undefined) {

						$(this).addClass("activo");
						if(data[g] == 1) {
							faicon = "ti-eye";
							var title = "mirando";
						} else if(data[g] == 2) {
							var title = "Visto";faicon = "ti-circle-check";
						} else if(data[g] == 3) {
							var title = "Por ver";faicon = "ti-player-pause";
						} else if(data[g] == 4) {
							var title = "Favorito";faicon = "ti-heart";
						}
						$(this).attr('title',title);
						$(this).find('i').attr('class',"ti "+faicon);
						$(this).attr('data-status',faicon);
					}
				});
			}
		},
		error: function(xhr, status, error) {
			console.log(xhr.responseText);if(xhr.responseText == "token") { sesion_invalida();}
		},
		dataType: "json"
	});

}

var current_active = 0;
function es_guardado(anime = false){
	if(es_usuario()) {
		$.ajax({
			type:"POST",
			url:authdomain+"/api/es_guardado",
			data: {id: anime, api_token: api_token},
			success:function(data){
				if(data == "token") { sesion_invalida();}
				console.log(data);
				if(data) {
					actualizar_guardado(data);

					$('.guardar_anime').addClass('activo');
					current_active = data;
				} else {return false;}
			},
			error: function(xhr, status, error) {
				console.log(xhr.responseText);if(xhr.responseText == "token") { sesion_invalida();}
			},
			dataType: "json"
		});
	}
}

function actualizar_guardado(d = false) {
	var txt = 'Guardar anime';
	var icon = 'ti ti-shield-plus';
	$(".guardar_anime").attr('data-gd',d);
	switch (parseInt(d)) {
		case 0:
			txt = "Guardado";
			icon = "ti ti-bookmark";
			break;
		case 1:
			txt = "Mirando";
			icon = "ti ti-eye";
			break;
		case 2:
			txt = "Visto";
			icon = "ti ti-circle-check";
			break;
		case 3:
			txt = "Por ver";
			icon = "ti ti-player-pause";
			break;
		case 4:
			txt = "Favorito";
			icon = "ti ti-heart";
			break;
		case 5:
			txt = "Dropped";
			icon = "ti ti-thumb-down";
			break;
	}

	$(".guardar_anime i").attr('class',icon);
	$(".guardar_anime span").text(txt);
}
