								not.html('<p class="qr_nr">No tienes notificaciones nuevas.</p>');
							} else {
								not.html(oldnc);
								fecha_humana('.notify-list .timeago');
							}

						}


					}

	if(!$('.fullnots').length) {$('.notify-list').append('<a class="fullnots" href="/notificaciones">Ver todas</a>');}

