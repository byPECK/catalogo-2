/* GUARDAR */


function generarPaginacion(total, onPage) {
  if (window.matchMedia('(max-width: 768px)').matches) {
	  const $cont = $('.ajax-paginator');

  $cont.empty();
  $('#loadmore').hide();

  const $ul = $('<ul>').addClass('pagination').addClass('ajax-pagination');

  const crearItem = (texto, paginaNum, disabled = false, activo = false) => {
    const $li = $('<li>').addClass('page-item');

    if (disabled) $li.addClass('disabled');
    if (activo)   $li.addClass('active');

    const $a = $('<a>')
      .addClass('page-link d-bg3 b-dark')
      .attr('href', '#')
      .attr('data-page', paginaNum)
      .html(texto);

    if (!disabled && !activo) {
      $a.on('click', function (e) {
        e.preventDefault();
        pagina = parseInt($(this).data('page'), 10);
        $cont.find('li.active').removeClass('active');
        $(this).parent().addClass('active');
        onPage(pagina);
      });
    } else {
      $a.on('click', e => e.preventDefault());
    }

    return $li.append($a);
  };

  const crearDots = () => {
    const $li = $('<li>').addClass('page-item disabled');
    $li.append($('<span>').addClass('page-link d-bg3 b-dark').html('&hellip;'));
    return $li;
  };

  const win = 2;
  const start = Math.max(2, pagina - win);
  const end   = Math.min(total - 1, pagina + win);

  $ul.append(crearItem('&laquo;', pagina - 1, pagina === 1));
  $ul.append(crearItem(1, 1, false, pagina === 1));
  if (start > 2) $ul.append(crearDots());

  for (let i = start; i <= end; i++) {
    $ul.append(crearItem(i, i, false, i === pagina));
  }

  if (end < total - 1) $ul.append(crearDots());
  if (total > 1) $ul.append(crearItem(total, total, false, pagina === total));
  $ul.append(crearItem('&raquo;', pagina + 1, pagina === total));

  $cont.append($ul);
  $cont.show();
}
}

function fecha_humana(elem) {
	// Función interna para el cálculo de la fecha humanizada
	const getFechaHumana = (fechaString) => {
		if (!fechaString) return 'N/A';

		// Modificación clave: agregamos 'Z' para que se interprete como UTC
		const fechaPasada = new Date(fechaString + 'Z');
		const ahora = new Date();
		const diferenciaEnMilisegundos = ahora - fechaPasada;

		const segundos = Math.floor(diferenciaEnMilisegundos / 1000);
		const minutos = Math.floor(segundos / 60);
		const horas = Math.floor(minutos / 60);
		const dias = Math.floor(horas / 24);
		const meses = Math.floor(dias / 30.44);
		const años = Math.floor(dias / 365.25);

		if (años > 0) return `hace ${años} año${años > 1 ? 's' : ''}`;
		if (meses > 0) return `hace ${meses} mes${meses > 1 ? 'es' : ''}`;
		if (dias > 0) return `hace ${dias} día${dias > 1 ? 's' : ''}`;
		if (horas > 0) return `hace ${horas} hora${horas > 1 ? 's' : ''}`;
		if (minutos > 0) return `hace ${minutos} minuto${minutos > 1 ? 's' : ''}`;
		if (segundos > 0) return `hace ${segundos} segundo${segundos > 1 ? 's' : ''}`;

		return 'ahora mismo';
	};

	// Busca todos los elementos con la clase .timeago
	const elementosTimeago = document.querySelectorAll(elem);

	// Recorre cada elemento y actualiza su texto
	elementosTimeago.forEach(elemento => {
		const fechaOriginal = elemento.getAttribute('datetime');
		const fechaHumanizada = getFechaHumana(fechaOriginal);
		elemento.textContent = fechaHumanizada;
	});
}

function crear_cookie(cname, cvalue, exMins) {
				var d = new Date();
				d.setTime(d.getTime() + (exMins*60*1000));
				var expires = "expires="+d.toUTCString();
				document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
				}
			function leer_cookie(cname) {
				    var name = cname + "=";
				    var decodedCookie = decodeURIComponent(document.cookie);
				    var ca = decodedCookie.split(';');
				    for(var i = 0; i <ca.length; i++) {
					var c = ca[i];
					while (c.charAt(0) == ' ') {
					    c = c.substring(1);
					}
					if (c.indexOf(name) == 0) {
					    return c.substring(name.length, c.length);
					}
				    }
				    return "";
}
function msj_registro(toastItem, str = false) {

	var myToast = $.toast({
		text : str ? str : 'Solo usuarios con cuenta pueden utilizar esta función.',
		icon: 'error',
		hideAfter : 4000,
		bgColor : '#027bff',
		textColor : '#fff',
		loaderBg: '#ff9d00',
		position: {
			left: toastItem.offset().left-parseInt(230)+parseInt(toastItem.width()),
			top: toastItem.offset().top-parseInt(toastItem.height()*2.7),
		},
		});
		$('.jq-toast-wrap').css('position', 'absolute');

}

//Auth
var api_token = leer_cookie('jkauth');

$.ajaxSetup({
	crossDomain: true,
	xhrFields: { withCredentials: true },
});

function validar_usuario() {
	if(!leer_cookie('jkauth')) {
		location.href = authdomain;
	}
}
function sesion_invalida() {
	crear_cookie('jkauth', false, -0);
	$.alert({
		title: '¡Error!',
		content: 'Tu sesión no es válida o expiró, por favor inicia sesión nuevamente.',
	});
	location.href = authdomain+"/salir";
}
function es_usuario() {
	if(leer_cookie('jkauth')) {
		return true;
	}
	return false
}


