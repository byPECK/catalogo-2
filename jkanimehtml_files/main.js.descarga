							console.log(data);
							
								var myToast = $.toast({
 		 text : data == 1 ? 'Se agrego con éxito a tu lista' : 'Se removio de tu lista con exito',
		icon: 'success',
 		 hideAfter : 2000,
 		 bgColor : '#027bff',
